# ============================================================================
# API Service Environment Template
# Copy this file to .env, then fill the API keys and override values as needed.
# ============================================================================

# Runtime
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_TO_FILE=false
API_HOST=0.0.0.0
API_PORT=8000
# Host interface used by Docker port publishing. Use your server's private/LAN IP in production.
API_BIND_ADDRESS=127.0.0.1
# HAProxy configuration has four discovery slots; use 1-4 replicas.
API_REPLICAS=2
MAX_UPLOAD_SIZE_MB=50
# Optional shared bearer token required on all non-health endpoints when set.
API_AUTH_TOKEN=

# LLM provider
# provider_chain (default): ordered fallback over groq, openrouter and custom_<N> endpoints
# openai_compatible: one endpoint (Ollama, vLLM, LM Studio, llama.cpp server, LiteLLM, OpenAI)
# local: in-process llama.cpp GGUF (requirements-local.txt)  |  groq | openrouter | huggingface presets
# Any model id is accepted; nothing is validated against a list.
LLM_PROVIDER=provider_chain
LLM_PROVIDER_ORDER=groq,openrouter
# openai_compatible endpoint (key optional for self-hosted servers):
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_API_KEY=
# Custom chain endpoints, referenced as custom_1, custom_2, ... in LLM_PROVIDER_ORDER:
# LLM_CUSTOM_1_BASE_URL=http://vllm:8000/v1
# LLM_CUSTOM_1_API_KEY=
# LLM_CUSTOM_1_MODEL=Qwen/Qwen2.5-14B-Instruct
# In-process model (LLM_PROVIDER=local):
# LLM_LOCAL_MODEL_PATH=/app/data/models/grader.gguf
# LLM_LOCAL_N_CTX=4096
# LLM_LOCAL_N_GPU_LAYERS=0
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.3
LLM_MAX_NEW_TOKENS=2048
LLM_DEVICE=cloud
LLM_REQUEST_TIMEOUT=60
LLM_TOTAL_TIMEOUT=110

# Provider-specific model overrides
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=openai/gpt-oss-120b
GROQ_KEY_MAX_INDEX=6
OPENROUTER_KEY_MAX_INDEX=7
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=RAG Essay Grading API

# API keys
GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_API_KEY_2=gsk_your_second_groq_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
# OPENROUTER_API_KEY_2=sk-or-v1-your_second_openrouter_api_key_here
HUGGINGFACE_API_TOKEN=hf_your_huggingface_api_token_here
PINECONE_API_KEY=pcsk_your_pinecone_api_key_here

# Embeddings
# huggingface (default, needs HUGGINGFACE_API_TOKEN) | openai_compatible | local
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-m3
# cpu | cuda | mps (local provider only; legacy "cloud" means cpu)
EMBEDDING_DEVICE=cloud
# EMBEDDING_BASE_URL=http://ollama:11434/v1
# EMBEDDING_API_KEY=
# fastembed | sentence_transformers (EMBEDDING_PROVIDER=local)
# EMBEDDING_LOCAL_BACKEND=fastembed
# EMBEDDING_BATCH_SIZE=64
# Collections record provider/model/dimension; switching them on a populated
# course returns HTTP 409 until the materials are re-ingested.

# Vector store
VECTORSTORE_TYPE=chroma
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=course_materials
CHROMA_CLIENT_MODE=http
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_SSL=false
ANONYMIZED_TELEMETRY=false

# Cross-replica consistency
REDIS_URL=redis://redis:6379/0
DISTRIBUTED_LOCK_ENABLED=true
DISTRIBUTED_LOCK_PREFIX=airag:lock
DISTRIBUTED_LOCK_TTL_SECONDS=900
DISTRIBUTED_LOCK_WAIT_SECONDS=120

# Document processing
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval and reranking
RETRIEVAL_TOP_K=5
RETRIEVAL_SEARCH_TYPE=similarity
ENABLE_RERANKING=false
RERANK_TOP_K=3
# none | bm25 | local_cross_encoder | http_rerank | llm_rerank | pinecone ("bge" = pinecone)
RERANKER_TYPE=bge
RERANKER_MODEL=bge-reranker-v2-m3
# http_rerank / llm_rerank endpoint; http_rerank style: cohere (Cohere/Jina/vLLM/Infinity) or tei
# RERANKER_BASE_URL=http://tei-rerank:8080
# RERANKER_API_KEY=
# RERANKER_API_STYLE=cohere
# RERANKER_DEVICE=cpu
# RERANKER_TIMEOUT=30

# Grading behavior
GRADING_MIN_CONFIDENCE=0.5
GRADING_REQUIRE_CITATIONS=true
GRADING_MAX_SCORE=100

# Grading prompt language: auto (match question/answer; inconclusive -> id) | en | id
PROMPT_LANGUAGE=auto

# Multimodal document processing
ENABLE_IMAGE_EXTRACTION=false
ENABLE_VISION_CAPTIONING=false
# Vision endpoint (defaults: HuggingFace Router + HUGGINGFACE_API_TOKEN)
# VISION_BASE_URL=https://router.huggingface.co/v1
# VISION_API_KEY=
# VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# CLI client (python -m src.cli); token defaults to API_AUTH_TOKEN
# RAG_API_URL=http://127.0.0.1:8000
# RAG_API_TOKEN=

# UI settings, if enabled later
UI_PORT=7860
UI_SHARE=false
