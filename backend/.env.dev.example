# ============================================================================
# Dev / quickstart environment (docker-compose.dev.yml or a local venv).
# No cloud API keys required: everything points at an OpenAI-compatible server.
# Copy to .env.dev for Docker (or export the variables / copy to .env for a venv).
# ============================================================================

LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=50
# Optional: protect the API (the CLI picks it up via RAG_API_TOKEN or API_AUTH_TOKEN).
API_AUTH_TOKEN=

# LLM: bundled Ollama (--profile local). For Ollama on the host use
# http://host.docker.internal:11434/v1; for vLLM/LM Studio/OpenAI set their URL and key.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b-instruct
LLM_TEMPERATURE=0.2
LLM_MAX_NEW_TOKENS=2048
LLM_REQUEST_TIMEOUT=120
LLM_TOTAL_TIMEOUT=180

# Embeddings: Ollama serves bge-m3 on /v1/embeddings.
# Alternative without a server: EMBEDDING_PROVIDER=local (build with INSTALL_LOCAL_EXTRAS=true).
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=http://ollama:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3

# Retrieval / reranking (BM25 is local and needs nothing extra).
RETRIEVAL_TOP_K=8
RERANK_TOP_K=4
ENABLE_RERANKING=true
RERANKER_TYPE=bm25

# auto = answer in the language of the question/answer (en or id).
PROMPT_LANGUAGE=auto

ENABLE_IMAGE_EXTRACTION=false
ENABLE_VISION_CAPTIONING=false
