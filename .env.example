# ============================================================================
# API Service Environment Template
# Copy this file to .env, then fill the API keys and override values as needed.
# ============================================================================

# Runtime
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_TO_FILE=false
API_HOST=0.0.0.0
API_PORT=8000
# Host interface used by Docker port publishing. Use 192.168.27.218 on the target server.
API_BIND_ADDRESS=127.0.0.1
# HAProxy configuration has four discovery slots; use 1-4 replicas.
API_REPLICAS=2
MAX_UPLOAD_SIZE_MB=50

# LLM provider fallback
LLM_PROVIDER=provider_chain
LLM_PROVIDER_ORDER=groq,openrouter
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.3
LLM_MAX_NEW_TOKENS=2048
LLM_DEVICE=cloud
LLM_REQUEST_TIMEOUT=60
LLM_TOTAL_TIMEOUT=110

# Provider-specific model overrides
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=openai/gpt-oss-120b
GROQ_KEY_MAX_INDEX=6
OPENROUTER_KEY_MAX_INDEX=7
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=RAG Essay Grading API

# API keys
GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_API_KEY_2=gsk_your_second_groq_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
# OPENROUTER_API_KEY_2=sk-or-v1-your_second_openrouter_api_key_here
HUGGINGFACE_API_TOKEN=hf_your_huggingface_api_token_here
PINECONE_API_KEY=pcsk_your_pinecone_api_key_here

# Embedding and vectorstore
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cloud
VECTORSTORE_TYPE=chroma
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=course_materials
CHROMA_CLIENT_MODE=http
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_SSL=false
ANONYMIZED_TELEMETRY=false

# Cross-replica consistency
REDIS_URL=redis://redis:6379/0
DISTRIBUTED_LOCK_ENABLED=true
DISTRIBUTED_LOCK_PREFIX=airag:lock
DISTRIBUTED_LOCK_TTL_SECONDS=900
DISTRIBUTED_LOCK_WAIT_SECONDS=120

# Document processing
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval and reranking
RETRIEVAL_TOP_K=5
RETRIEVAL_SEARCH_TYPE=similarity
ENABLE_RERANKING=false
RERANK_TOP_K=3
RERANKER_TYPE=bge
RERANKER_MODEL=bge-reranker-v2-m3

# Grading behavior
GRADING_MIN_CONFIDENCE=0.5
GRADING_REQUIRE_CITATIONS=true
GRADING_MAX_SCORE=100

# Multimodal document processing
ENABLE_IMAGE_EXTRACTION=false
ENABLE_VISION_CAPTIONING=false

# UI settings, if enabled later
UI_PORT=7860
UI_SHARE=false
