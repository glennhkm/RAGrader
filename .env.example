# ============================================================================
# Environment Variables Configuration Template
# ============================================================================

# Groq API Key for LLM grading (Llama 3.1 8B/70B)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here

# HuggingFace Token for Embeddings Generator (BAAI/bge-m3 via Inference API)
# Get your token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=hf_your_huggingface_api_token_here

# Pinecone API Key for Reranker (bge-reranker-v2-m3)
# Optional: Only needed if retrieval.enable_reranking=true and retrieval.reranker_type=bge
PINECONE_API_KEY=pcsk_your_pinecone_api_key_here

# Application Settings
ENVIRONMENT=production
LOG_LEVEL=INFO

# Multimodal Settings (Optional: defaults can be set in config.yaml)
ENABLE_IMAGE_EXTRACTION=false
ENABLE_VISION_CAPTIONING=false
